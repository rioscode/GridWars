--- control.bmx
+++ control.bmx
@@ -10,0 +11,20 @@
+Function CaptureOriginalMenuFrame(counter:Int)
+	If AppArgs.length < 3 Or counter <> 20 Then Return
+	Local mode$ = AppArgs[1]
+	If mode = "options-game" Or mode = "confirm-exit" Or ..
+		mode = "confirm-end-game" Or mode = "confirm-keep-video" Or ..
+		mode = "confirm-keep-game" Or mode = "settings" Or ..
+		mode = "video" Or mode = "game" Or mode = "audio" Or ..
+		mode = "controller" Or mode = "hybrid" Or mode = "mouse" Or ..
+		mode = "keyboard" Or mode = "joypad" Or mode = "dual-analog"
+		SaveScreenshot(AppArgs[2]+"/"+mode+".png")
+		End
+	EndIf
+End Function
